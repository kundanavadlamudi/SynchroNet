# NexTrace — Environment Configuration Template
# Copy this file to .env and populate with your authorized credentials.
# NEVER commit .env or live API tokens into version control.

# ---------------------------------------------------------------------------
# X API v2 (Primary Social Media Provider)
# ---------------------------------------------------------------------------
# Bearer token for Twitter / X API v2 (e.g. recent search: /2/tweets/search/recent)
# Handled server-side only; tokens are masked in logs and reports.
X_BEARER_TOKEN=your_x_bearer_token_here

# ---------------------------------------------------------------------------
# Reddit Data API (Secondary Social Media Provider)
# ---------------------------------------------------------------------------
# Reddit script app credentials or OAuth token
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=NexTrace:disinformation.research:v1.0.0 (by /u/your_username)

# ---------------------------------------------------------------------------
# Google Fact Check Tools API (OSINT Claim Verification)
# ---------------------------------------------------------------------------
# Google Cloud API key with Fact Check Tools API enabled
GOOGLE_FACT_CHECK_API_KEY=your_google_fact_check_api_key_here

# ---------------------------------------------------------------------------
# OSINT & Feature Toggles
# ---------------------------------------------------------------------------
# Enable / disable RDAP domain registration lookups (default: true)
NEXTRACE_ENABLE_RDAP=true

# Enable / disable computer vision and OCR text extraction (default: true)
NEXTRACE_ENABLE_OCR=true

# ---------------------------------------------------------------------------
# Generic REST / Feed API Provider (Optional)
# ---------------------------------------------------------------------------
# Base URL of an authorized REST API or custom feed endpoint
NEXTRACE_API_BASE_URL=https://api.example.com/v2

# Bearer token for the generic API provider
NEXTRACE_API_BEARER_TOKEN=your_authorized_bearer_token_here

# Network timeout in seconds for API requests
NEXTRACE_API_TIMEOUT_SECONDS=15

# Maximum retry attempts for transient errors (429, 500, 502, 503, 504)
NEXTRACE_API_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Pipeline Detection Settings (Optional overrides for src/config.py)
# ---------------------------------------------------------------------------
# Minimum semantic cosine similarity (0.0 - 1.0) for pairing posts
NEXTRACE_SEMANTIC_THRESHOLD=0.70

# Maximum minutes between posts to flag as synchronized
NEXTRACE_TIME_WINDOW_MINUTES=10

# Risk priority classification thresholds
NEXTRACE_RISK_HIGH_THRESHOLD=0.80
NEXTRACE_RISK_MEDIUM_THRESHOLD=0.60
